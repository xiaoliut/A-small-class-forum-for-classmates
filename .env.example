# 复制为 .env 后按需修改（不配置也能直接运行，AI 会使用内置规则引擎）

# 服务端口与对外地址
PORT=3000
HOST=127.0.0.1
# 站点名称（显示在导航栏与页脚）
SITE_NAME=班级论坛

# 会话密钥，生产环境务必改成随机长字符串
SESSION_SECRET=change-me-to-a-long-random-string

# 是否记录 HTTP 访问日志（1/0）
ACCESS_LOG=1

# ---------------------------------------------------------------------------
# AI 审核：留空则使用内置的本地规则引擎（不联网、不需要 API Key）
# 填好下面三项后，会调用任意 OpenAI 兼容的 chat/completions 接口做语义审核
# ---------------------------------------------------------------------------
AI_ENABLED=0
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=8000

# 无违规的帖子是否自动通过审核（1=自动通过，0=全部转人工）
AI_AUTO_APPROVE=1

