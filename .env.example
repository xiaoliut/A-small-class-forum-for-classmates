# 复制为 .env 后按需修改（不配置也能直接运行，AI 会使用内置规则引擎）

# 服务端口与对外地址
PORT=3000
HOST=127.0.0.1
# 站点名称（显示在导航栏与页脚）
SITE_NAME=班级论坛

# 会话密钥，生产环境务必改成随机长字符串
SESSION_SECRET=change-me-to-a-long-random-string

# 是否记录 HTTP 访问日志（1/0）
ACCESS_LOG=1

# ---------------------------------------------------------------------------
# AI 审核：留空则使用内置的本地规则引擎（不联网、不需要 API Key）
# 填好下面三项后，会调用任意 OpenAI 兼容的 chat/completions 接口做语义审核
# ---------------------------------------------------------------------------
AI_ENABLED=0
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=8000

# 无违规的帖子是否自动通过审核（1=自动通过，0=全部转人工）
AI_AUTO_APPROVE=1

# #demo-start
# ---------------------------------------------------------------------------
# 演示模式（用于对外演示的站点）
#   1 = 开启：访客自动以「共用的超级管理员」身份进入，站点设置只读；
#           并且每隔一段时间清理一次游客数据（帖子、评论、非超管账号）
#   0 = 关闭：正常论坛
# ---------------------------------------------------------------------------
DEMO_MODE=0
# 清理间隔（毫秒），默认 1 小时
DEMO_CLEAN_INTERVAL=3600000
# 站长入口路径（演示模式下不会被自动登录接管）：
# 例如设成 master，则访问 http://站点/master 可以正常输账号密码登录
MASTER_PATH=master
# 进入站长控制台的口令（留空则只靠路径隐蔽，不校验口令）
MASTER_KEY=
# 站长登录框上方显示的账号提示（留空则不显示），例如：admin / 123456
MASTER_LOGIN_HINT=
# #demo-end
