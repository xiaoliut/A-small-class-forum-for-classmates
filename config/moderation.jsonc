// ===========================================================================
//  AI 审核规则 —— 想调整「什么内容会被拦下来」就改这里
// ===========================================================================
//  规则如何生效：
//    每条规则命中一次就累加它的 weight（权重），所有命中加起来得到风险分（0-100）。
//      · 风险分 >= thresholds.violation → 判为违规，进入人工复核队列
//      · 风险分 >= thresholds.review    → 建议人工复核
//      · 低于 review                    → 视为正常，自动公开（当 aiAutoApprove 为 true 时）
//
//  words    ：普通关键词，命中即算（大小写不敏感）
//  patterns ：正则表达式，适合手机号、外链这类模式匹配
//
//  注意 JSON 里反斜杠要写两次：`\b` 要写成 `\\b`，`\S` 要写成 `\\S`
//  改完点后台「重新加载配置」生效，不需要重启。
// ===========================================================================
{
  // AI 判定正常时是否自动公开（和 site.jsonc 里的 features.aiAutoApprove 二选一，任一为 false 都会转人工）
  "autoApprove": true,

  // 风险分阈值
  "thresholds": {
    "review": 20,
    "violation": 60
  },

  // 按类别配置的关键词与权重
  "categories": {
    "违法违禁": {
      "weight": 60,
      "words": ["毒品", "枪支", "赌博", "博彩", "代考", "作弊器", "刷单", "洗钱"]
    },
    "色情低俗": {
      "weight": 60,
      "words": ["色情", "约炮", "裸聊", "黄色网站"]
    },
    "人身攻击": {
      "weight": 40,
      "words": ["傻逼", "滚蛋", "废物", "脑残", "去死", "垃圾人", "白痴"]
    },
    "广告推广": {
      "weight": 30,
      "words": ["加微信", "加vx", "加qq", "私聊购买", "代购", "兼职日结", "刷赞", "扫码进群", "包邮", "低价出售"]
    },
    "联系方式": {
      "weight": 20,
      "words": [],
      "patterns": [
        "\\b1[3-9]\\d{9}\\b",                          // 中国大陆手机号
        "(?:wx|vx|qq)\\s*[:：]?\\s*[a-zA-Z0-9_-]{5,}"   // 微信号 / QQ 号
      ]
    },
    "拉人外链": {
      "weight": 25,
      "patterns": [
        "(?:https?://|www\\.)\\S+",                    // http/https/www 开头的链接
        "\\S+\\.(?:com|cn|net|top|xyz)\\b"             // 裸域名
      ]
    },
    "敏感话题": {
      "weight": 35,
      "words": ["涉政", "抗议", "上访", "邪教"]
    },
    "灌水刷屏": {
      "weight": 15,
      "patterns": [
        "(.)\\1{6,}",      // 同一字符重复 7 次以上，例如 ！！！！！！！
        "[!！?？]{5,}"     // 连续 5 个以上标点
      ]
    }

    // 想加自己的类别就照抄一份（注意给上一行补逗号）：
    // "校外培训": { "weight": 30, "words": ["一对一辅导", "提分班", "名师押题"] }
  },

  // 组合规则：比单个关键词更精确一点
  "textRules": [
    {
      "label": "广告推广",
      "weight": 15,
      "pattern": "(?:加|搜|联系)\\s*(?:我|本人)?\\s*(?:的)?\\s*(?:微信|vx|wx|qq)\\s*\\d*",
      "keyword": "引导添加联系方式"
    },
    {
      "label": "广告推广",
      "weight": 20,
      "pattern": "(二手|闲置).{0,20}(转让|出售|甩卖|低价|包邮|秒杀)",
      "keyword": "疑似商品交易"
    },
    {
      "label": "招生招聘",
      "weight": 25,
      "pattern": "(招|找)(?:人|兼职|代理|学徒)|日结|月入过万|轻松赚钱",
      "keyword": "疑似招聘/兼职广告"
    }
  ],

  // 发帖时给作者的「分区建议」用到的关键词
  "sectionKeywords": {
    "study": ["题", "作业", "考试", "笔记", "复习", "课", "老师", "成绩", "错题", "学习"],
    "life": ["运动会", "食堂", "宿舍", "春游", "活动", "班会", "生日", "同学", "操场", "社团"],
    "notice": ["通知", "公告", "安排", "提醒", "必读", "规范"]
  }
}
