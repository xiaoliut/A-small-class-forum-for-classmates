// ===========================================================================
//  论坛分区 —— 想加/删/改名板块就改这里
// ===========================================================================
//  key       ：分区标识，会写进数据库，建议用英文短词，改动后老帖子仍留在原分区
//  name      ：显示名称
//  desc      ：分区说明，发帖页的下拉框和分区导航会用到
//  adminOnly ：true = 只有管理员能在这里发帖（例如公告区）
//
//  删掉这个文件 = 使用内置的四个默认分区。
//  改完同样点后台「重新加载配置」或重启服务生效。
// ===========================================================================
{
  "sections": [
    { "key": "general", "name": "综合讨论", "desc": "什么都可以聊两句" },
    { "key": "study", "name": "学习交流", "desc": "作业、错题、考试互助" },
    { "key": "life", "name": "班级生活", "desc": "活动、通知、日常记录" },
    { "key": "notice", "name": "公告通知", "desc": "管理员发布的正式通知", "adminOnly": true }
  ]
}

