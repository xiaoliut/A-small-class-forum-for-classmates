// 站点配置文件 —— 改完保存后在后台点「重新加载」，或重启服务即可生效。
// 也可以在后台「站点设置」页直接编辑，保存时会自动写回本文件。
// 删除某个字段即恢复该字段的默认值；整个文件删掉也能正常运行。
{
  // -------------------------------------------------------------------------
  // 站点信息
  // -------------------------------------------------------------------------
  "siteName": "长兴县金陵高级中学高一（3）班班级论坛",
  "siteTagline": "班级角落",
  "siteDescription": "分享学习心得、记录班级活动、发布通知公告的班级论坛。",
  "welcomeMessage": "欢迎来到班级论坛",
  "adminContact": "",

  // -------------------------------------------------------------------------
  // 页脚（版权 / 备案号 / 自定义文字 / 链接）
  //   copyright  : 支持多行，一行一条；行末加 |网址 则该行可点击
  //   extraLines : 额外文字行，一行一条
  //   links      : 额外链接，格式 文字|网址
  // -------------------------------------------------------------------------
  "footer": {
    "copyright": "长兴县金陵高级中学高一（3）班班级论坛",
    "icp": "",
    "police": "",
    "customText": "",
    "extraLines": [],
    "links": [],
    "showPoweredBy": false,
    "poweredByText": ""
  },

  // -------------------------------------------------------------------------
  // 功能开关（true = 开，false = 关）
  // -------------------------------------------------------------------------
  "features": {
    "aiModeration": false,  // AI 辅助审核总开关；false = 纯人工审核（所有帖子转待审）
    "aiAutoApprove": true,  // AI 判定正常时是否自动通过；false = 所有帖子都转人工
    "allowRegister": true   // 是否允许提交新的入班申请
  }
}
