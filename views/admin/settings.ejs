<%- include('../partials/header', { title: title, activeNav: 'admin' }) %>

<div class="page-head">
  <div>
    <h1>站点设置</h1>
    <p class="page-head__sub">这里改的内容保存后<strong>立即生效</strong>，同时会写回 <code class="config-path">config/site.jsonc</code>，方便版本管理。</p>
  </div>
  <div class="btn-row">
    <a class="btn btn--ghost" href="/admin">返回后台</a>
    <a class="btn btn--ghost" href="/" target="_blank">查看前台</a>
  </div>
</div>

<%- include('partials/tabs', { tab: 'settings' }) %>


<div class="layout">
  <div class="layout__main">
    <form action="/admin/settings" method="post">
      <%- csrfInput %>

      <fieldset class="fieldset">
        <legend>基本信息</legend>

        <div class="form-row">
          <label class="field-label required" for="siteName">站点名称</label>
          <input type="text" id="siteName" name="siteName" value="<%= site.siteName %>" maxlength="60" required>
          <div class="field-hint">显示在导航栏、浏览器标题和页脚。</div>
        </div>

        <div class="form-row">
          <label class="field-label" for="siteTagline">一句话副标题</label>
          <input type="text" id="siteTagline" name="siteTagline" value="<%= site.siteTagline %>" maxlength="80">
        </div>

        <div class="form-row">
          <label class="field-label" for="siteDescription">站点介绍</label>
          <textarea id="siteDescription" name="siteDescription" maxlength="300" style="min-height:80px"><%= site.siteDescription %></textarea>
          <div class="field-hint">显示在首页横幅与搜索引擎描述里。</div>
        </div>

        <div class="form-row">
          <label class="field-label" for="welcomeMessage">首页欢迎语句</label>
          <textarea id="welcomeMessage" name="welcomeMessage" maxlength="200" style="min-height:60px"><%= site.welcomeMessage || '' %></textarea>
          <div class="field-hint">显示在首页顶部的大字标题，例如「欢迎来到XX班」。</div>
        </div>

        <div class="form-row">
          <label class="field-label" for="adminContact">管理员联系方式</label>
          <input type="text" id="adminContact" name="adminContact" value="<%= site.adminContact %>" maxlength="120" placeholder="例如：高一(3)班 李老师">
          <div class="field-hint">留空则不显示。会出现在页脚。</div>
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend>页脚 · 版权与备案</legend>

        <div class="form-row">
          <label class="field-label" for="footerCopyright">版权声明（可写多行，一行一条）</label>
          <textarea id="footerCopyright" name="footerCopyright" maxlength="500" style="min-height:88px"
                    placeholder="一行一条，格式：文字|链接（链接可选）&#10;例如：&#10;杂鱼科技-杂鱼工作室|https://zayukeji.top&#10;班级论坛"><%= site.footer.copyright || '' %></textarea>
          <div class="field-hint">每行会自动加「© 年份」前缀；行末用 <code>|</code> 接网址则该行可点击，不带 <code>|链接</code> 就是纯文字；留空则默认一条「© <%= new Date().getFullYear() %> <%= site.siteName %>」。</div>
        </div>

        <div class="form-row--half">
          <div class="form-row">
            <label class="field-label" for="footerIcp">ICP 备案号</label>
            <input type="text" id="footerIcp" name="footerIcp" value="<%= site.footer.icp %>" maxlength="120"
                   placeholder="例如：京ICP备2024000000号-1">
            <div class="field-hint">未备案的服务器请留空，会自动隐藏。</div>
          </div>
          <div class="form-row">
            <label class="field-label" for="footerPolice">公安备案号</label>
            <input type="text" id="footerPolice" name="footerPolice" value="<%= site.footer.police %>" maxlength="120"
                   placeholder="例如：京公网安备 11010502000000号">
          </div>
        </div>

        <div class="form-row">
          <label class="field-label" for="footerCustomText">自定义底部文字</label>
          <textarea id="footerCustomText" name="footerCustomText" maxlength="400" style="min-height:70px"
                    placeholder="例如：本站仅用于班级内部交流，请勿转载内容到公开平台"><%= site.footer.customText %></textarea>
          <div class="field-hint">显示在版权上方，可以写免责声明、班级口号等。</div>
        </div>

        <div class="form-row">
          <label class="field-label" for="footerExtraLines">额外文字行</label>
          <textarea id="footerExtraLines" name="footerExtraLines" style="min-height:70px"
                    placeholder="一行一条，例如：&#10;内容版权归原作者所有&#10;有问题请联系超级管理员"><%= (site.footer.extraLines || []).join('\n') %></textarea>
          <div class="field-hint">一行一条，最多 20 行。</div>
        </div>

        <div class="form-row">
          <label class="field-label" for="footerLinks">页脚额外链接</label>
          <textarea id="footerLinks" name="footerLinks" style="min-height:70px"
                    placeholder="一行一条，格式：链接文字|地址&#10;班级公约|/rules&#10;学校官网|https://example.com"><%= (site.footer.links || []).map(function (l) { return l.label + '|' + l.href; }).join('\n') %></textarea>
          <div class="field-hint">地址以 / 开头表示站内页面，http(s) 开头会新窗口打开。</div>
        </div>

        <div class="form-row">
          <label class="field-label" for="footerPoweredByText">底部技术说明文字</label>
          <input type="text" id="footerPoweredByText" name="footerPoweredByText" value="<%= site.footer.poweredByText %>" maxlength="160">
        </div>

        <div class="form-row" style="margin-bottom:0">
          <label style="display:flex;gap:8px;align-items:center;font-weight:600;font-size:.9rem">
            <input type="checkbox" name="footerShowPoweredBy" style="width:auto" <%= site.footer.showPoweredBy !== false ? 'checked' : '' %>>
            显示底部技术说明
          </label>
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend>功能开关</legend>

        <div class="form-row">
          <label style="display:flex;gap:8px;align-items:center;font-weight:600;font-size:.9rem">
            <input type="checkbox" name="featureAiModeration" style="width:auto" <%= site.features.aiModeration !== false ? 'checked' : '' %>>
            启用 AI 辅助审核
          </label>
          <div class="field-hint">关闭后新帖直接公开，不做任何检测。</div>
        </div>

        <div class="form-row">
          <span class="field-label">审批模式</span>
          <label style="display:flex;gap:8px;align-items:center;font-size:.9rem;margin-bottom:6px">
            <input type="radio" name="approvalMode" value="auto" style="width:auto" <%= site.features.aiAutoApprove !== false ? 'checked' : '' %>>
            <strong>AI 自动审批</strong> —— AI 判定正常的帖子直接公开，拿不准/违规的转人工复核
          </label>
          <label style="display:flex;gap:8px;align-items:center;font-size:.9rem">
            <input type="radio" name="approvalMode" value="manual" style="width:auto" <%= site.features.aiAutoApprove === false ? 'checked' : '' %>>
            <strong>全人工审批</strong> —— 所有帖子都先进入待审核，管理员通过后才展示
          </label>
        </div>

        <div class="form-row" style="margin-bottom:0">
          <label style="display:flex;gap:8px;align-items:center;font-weight:600;font-size:.9rem">
            <input type="checkbox" name="featureAllowRegister" style="width:auto" <%= site.features.allowRegister !== false ? 'checked' : '' %>>
            允许提交入班申请
          </label>
          <div class="field-hint">关闭后注册入口隐藏，只能由管理员手动开通账号。</div>
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend>AI 大模型接入（可选）</legend>

        <div class="form-row">
          <label style="display:flex;gap:8px;align-items:center;font-weight:600;font-size:.9rem">
            <input type="checkbox" name="aiEnabled" style="width:auto" <%= ai.enabled ? 'checked' : '' %>>
            启用大模型审核
          </label>
          <div class="field-hint">勾选并填写接口信息后，审核优先用大模型语义判断；未配置或调用失败时自动回退到离线规则库。</div>
        </div>

        <div class="form-row--half">
          <div class="form-row">
            <label class="field-label" for="aiBaseUrl">接口地址 Base URL</label>
            <input type="text" id="aiBaseUrl" name="aiBaseUrl" value="<%= ai.baseUrl %>" placeholder="https://api.deepseek.com">
            <div class="field-hint">OpenAI 兼容接口，例如 https://api.deepseek.com 或 https://api.openai.com/v1</div>
          </div>
          <div class="form-row">
            <label class="field-label" for="aiModel">模型名</label>
            <input type="text" id="aiModel" name="aiModel" value="<%= ai.model %>" placeholder="deepseek-chat">
          </div>
        </div>

        <div class="form-row--half">
          <div class="form-row">
            <label class="field-label" for="aiApiKey">API Key</label>
            <input type="password" id="aiApiKey" name="aiApiKey" value="<%= ai.apiKey %>" placeholder="sk-..." autocomplete="off">
            <div class="field-hint">密钥只存在服务器数据库，不会写进源码包。</div>
          </div>
          <div class="form-row">
            <label class="field-label" for="aiTimeoutMs">超时（毫秒）</label>
            <input type="number" id="aiTimeoutMs" name="aiTimeoutMs" value="<%= ai.timeoutMs %>" min="1000" max="60000">
          </div>
        </div>

        <div class="field-hint" style="margin-bottom:0">
          当前模式：<%= ai.enabled && ai.baseUrl && ai.apiKey ? '大模型接入（' + ai.model + '）' : '离线规则库' %>
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend>论坛规范（/rules 页面）</legend>
        <div class="form-row" style="margin-bottom:0">
          <label class="field-label" for="rulesText">规范内容</label>
          <textarea id="rulesText" name="rulesText" style="min-height:220px" placeholder="## 开头为标题，- 开头为列表项，数字. 开头为有序列表，空行分段"><%= rulesText %></textarea>
          <div class="field-hint">保存后 /rules 页面的「论坛规范」立即更新。<strong>## </strong>= 小标题；<strong>- </strong>= 列表项；空行 = 分段。</div>
        </div>
      </fieldset>

      <div class="form-actions">
        <button class="btn btn--primary" type="submit">保存设置</button>
        <span class="text-mute text-sm">保存后立即生效，无需重启服务。</span>
      </div>
    </form>
  </div>

  <aside class="side">
    <div class="card">
      <h2 class="card__title" style="margin-bottom:10px">可修改的文件</h2>
      <table class="data table--compact">
        <tbody>
          <% files.forEach(function (file) { %>
            <tr>
              <td>
                <code class="config-path"><%= file.name %></code>
                <div class="text-xs text-mute" style="margin-top:3px"><%= file.desc %></div>
              </td>
              <td class="cell-nowrap">
                <% if (!file.exists) { %><span class="badge badge--muted">未创建</span>
                <% } else if (file.writable) { %><span class="badge badge--ok">可写</span>
                <% } else { %><span class="badge badge--warn">只读</span><% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <p class="text-xs text-mute" style="margin-top:10px">
        当前已加载：<strong><%= sectionsCount %></strong> 个分区 · <strong><%= ruleCount %></strong> 个审核类别
      </p>
      <p class="text-xs text-mute mb-0">
        部署与端口等参数在 <code class="config-path">.env</code>，AI 接口密钥也在那里。
      </p>
    </div>

    <div class="card">
      <h2 class="card__title" style="margin-bottom:10px">直接改文件之后</h2>
      <p class="text-sm text-soft">
        如果你习惯直接编辑 <code class="config-path">config/*.jsonc</code>，改完点下面的按钮即可生效，
        <strong>不需要重启服务</strong>。
      </p>
      <form action="/admin/settings/reload" method="post" style="margin-bottom:8px">
        <%- csrfInput %>
        <button class="btn btn--ok btn--block" type="submit">重新加载配置</button>
      </form>
      <form action="/admin/settings/reset" method="post" data-confirm="确定放弃后台保存的设置，恢复为配置文件里的内容吗？">
        <%- csrfInput %>
        <button class="btn btn--ghost btn--block" type="submit">恢复为配置文件默认值</button>
      </form>
      <p class="text-xs text-warn" style="margin-top:10px">
        如果改了 <code class="config-path">site.jsonc</code> 却看不到变化：说明这些字段之前在后台保存过，
        数据库里的值优先级更高。先点「恢复为配置文件默认值」，再点「重新加载配置」即可。
      </p>
    </div>

    <div class="card">
      <h2 class="card__title" style="margin-bottom:10px">配置优先级</h2>
      <ol class="text-sm text-soft" style="padding-left:18px;margin:0">
        <li>后台保存的设置（数据库，优先级最高）</li>
        <li><code class="config-path">config/site.jsonc</code></li>
        <li>程序内置默认值</li>
      </ol>
      <% if (overrideKeys.length) { %>
        <p class="text-xs text-mute" style="margin-top:8px">
          数据库里已覆盖的字段：<%= overrideKeys.join('、') %>
        </p>
      <% } else { %>
        <p class="text-xs text-mute" style="margin-top:8px">当前没有数据库覆盖，全部来自配置文件。</p>
      <% } %>
    </div>
  </aside>
</div>

<%- include('../partials/footer') %>
