<%- include('partials/header', { title: title, activeNav: '' }) %>

<div class="card auth-card">
  <h1>修改密码</h1>
  <p class="text-mute text-sm">建议使用字母 + 数字的组合，至少 6 位。密码以哈希形式保存，管理员也看不到原文。</p>

  <!-- #demo-start -->
  <% if (masterProfileLocked) { %>
    <p class="master-hint">演示站点的超级管理员密码已锁定，无法修改。</p>
  <% } %>
  <!-- #demo-end -->

  <form action="/me/password" method="post" autocomplete="off">
    <%- csrfInput %>
    <div class="form-row">
      <label class="field-label required" for="current">当前密码</label>
      <input type="password" id="current" name="current" required>
    </div>
    <div class="form-row">
      <label class="field-label required" for="next">新密码</label>
      <input type="password" id="next" name="next" required minlength="6">
    </div>
    <div class="form-row">
      <label class="field-label required" for="confirm">确认新密码</label>
      <input type="password" id="confirm" name="confirm" required minlength="6">
    </div>
    <div class="form-actions">
      <button class="btn btn--primary" type="submit">保存新密码</button>
      <a class="btn btn--ghost" href="/me">返回个人中心</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
