<%- include('partials/header', { title: title, activeNav: '' }) %>

<div class="page-head">
  <div>
    <h1>我的帖子</h1>
    <p class="page-head__sub">包含正在审核、已公开和被驳回的帖子。</p>
  </div>
  <a class="btn btn--primary" href="/posts/new">发新帖</a>
</div>

<div class="card" style="padding:0">
  <% if (!posts.length) { %>
    <div class="empty"><span class="empty__icon"></span>你还没有发过帖子。<a href="/posts/new">现在写一篇</a>？</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th>标题</th>
            <th>分区</th>
            <th>状态</th>
            <th>AI</th>
            <th>浏览/评论</th>
            <th>发布时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% posts.forEach(function (post) { %>
            <% const s = statusBadge(post.status); %>
            <% const ai = aiBadge(post.ai_verdict); %>
            <tr>
              <td>
                <a href="/posts/<%= post.id %>"><%= post.title %></a>
                <% if (post.pinned) { %><span class="badge badge--accent">置顶</span><% } %>
                <% if (post.warning_reason) { %><span class="badge badge--warn">被警告</span><% } %>
              </td>
              <td class="cell-nowrap"><%= sectionMeta(post.section).name %></td>
              <td class="cell-nowrap"><span class="badge <%= s.cls %>"><%= s.name %></span></td>
              <td class="cell-nowrap"><span class="badge <%= ai.cls %>">风险 <%= post.ai_risk %></span></td>
              <td class="cell-nowrap text-mute"><%= post.view_count %> / <%= post.comment_count %></td>
              <td class="cell-nowrap text-mute"><%= formatTime(post.created_at) %></td>
              <td class="cell-nowrap">
                <div class="inline-controls">
                  <a class="btn btn--ghost btn--sm" href="/posts/<%= post.id %>/edit">编辑</a>
                  <% if (post.status !== 'deleted') { %>
                    <form action="/posts/<%= post.id %>/delete" method="post" data-confirm="确定删除这篇帖子吗？">
                      <%- csrfInput %>
                      <button class="btn btn--danger btn--sm" type="submit">删除</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
