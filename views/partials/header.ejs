<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f4f7fb">
  <meta name="description" content="<%= site.siteDescription || siteName %>">
  <title><%= title %> · <%= siteName %></title>
  <link rel="stylesheet" href="/static/css/style.css?v=12">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'></text></svg>">
</head>
<body>
<header class="topbar">
  <div class="container topbar__inner">
    <a class="brand" href="/">
      <span class="brand__mark"></span>
      <span class="brand__text"><%= siteName %></span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="展开导航">
    <label for="nav-toggle" class="nav-toggle-label" aria-label="展开导航">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav">
      <a class="nav__link <%= activeNav === 'home' ? 'is-active' : '' %>" href="/">首页</a>
      <a class="nav__link <%= activeNav === 'sections' ? 'is-active' : '' %>" href="/sections">分区</a>
      <% if (currentUser && currentUser.status === 'approved' && !currentUser.isMuted) { %>
        <a class="nav__link <%= activeNav === 'new' ? 'is-active' : '' %>" href="/posts/new">发帖</a>
      <% } %>
      <a class="nav__link <%= activeNav === 'rules' ? 'is-active' : '' %>" href="/rules">规范</a>
      <% if (currentUser && currentUser.isAdmin) { %>
        <a class="nav__link <%= activeNav === 'admin' ? 'is-active' : '' %>" href="/admin">
          管理后台
          <% if (typeof pendingBadge !== 'undefined' && pendingBadge > 0) { %><span class="nav__dot"></span><% } %>
        </a>
      <% } %>

      <div class="nav__user">
        <% if (currentUser) { %>
          <!-- #demo-start -->
          <% if (demoMode) { %>
            <span class="badge badge--info" title="演示站点：站点设置已锁定，游客数据每小时清理一次">演示模式</span>
          <% } %>
          <!-- #demo-end -->
          <a class="nav__me" href="/me">
            <%- avatarHtml(currentUser) %>
            <span class="nav__me-name"><%= currentUser.nickname %></span>
          </a>
          <form action="/logout" method="post" class="inline-form">
            <%- csrfInput %>
            <button type="submit" class="btn btn--ghost btn--sm"><!-- #demo-start --><%= demoMode ? '退出（换普通身份）' : '退出' %><!-- #demo-end -->退出</button>
          </form>
        <% } else { %>
          <!-- #demo-start -->
          <% if (demoMode) { %>
            <a class="btn btn--primary btn--sm" href="/demo/enter">以管理员身份演示</a>
          <% } %>
          <!-- #demo-end -->
          <a class="btn btn--ghost btn--sm" href="/login">登录</a>
          <% if (!featureFlags || featureFlags.allowRegister !== false) { %>
            <a class="btn btn--ghost btn--sm" href="/register">申请加入</a>
          <% } %>
        <% } %>
      </div>
    </nav>
  </div>
</header>

<!-- #demo-start -->
<% if (demoMode && isMasterUser) { %>
  <div class="container">
    <div class="alert alert--info">
      <strong>演示站点 · 站长模式</strong>：你是站长身份，站点设置可以修改，也可以在
      <a href="<%= masterBase || '/master' %>">站长控制台</a>里清场。
    </div>
  </div>
<% } else if (demoMode) { %>
  <div class="container">
    <div class="alert alert--info">
      <strong>演示站点</strong>：你正以共用的超级管理员身份浏览，<strong>站点设置已锁定、禁止修改</strong>；
      想体验普通同学请先「退出」，再走注册申请流程；
      帖子、评论和游客账号每小时清理一次。
    </div>
  </div>
<% } %>
<!-- #demo-end -->

<main class="container page">
  <% if (currentUser && currentUser.status !== 'approved' && typeof hidePendingBanner === 'undefined') { %>
    <div class="alert alert--warn">
      你的入班申请还在审核中，通过后才能发帖和评论。
      <% if (currentUser.isAdmin) { %>（管理员账号状态异常，请联系超级管理员）<% } %>
    </div>
  <% } %>

  <% if (currentUser && currentUser.isMuted) { %>
    <div class="alert alert--warn">
      你正处于禁言状态（至 <%= formatTime(currentUser.mute_until) %>），暂时不能发帖和评论。
    </div>
  <% } %>

  <% flash.forEach(function (item) { %>
    <div class="alert alert--<%= item.type === 'error' ? 'danger' : (item.type === 'success' ? 'success' : 'info') %>"><%= item.message %></div>
  <% }); %>
